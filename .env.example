PAYLOAD_SECRET=YOUR_SECRET_HERE
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SERVER_URL=https://www.lpnfoundation.org

# Optional fallback for a local DB snapshot without downloaded media files.
# Public media GETs are proxied to this origin in development when set.
DEV_MEDIA_ORIGIN=

# M1 help form on /[locale]/get-help (intake/docs/API.md). The form POSTs to
# the intake API only — never to Payload/Neon. Dev: run `node scripts/mock-intake.mjs`.
NEXT_PUBLIC_INTAKE_URL=http://localhost:3100
# Cloudflare Turnstile site key. The default is Cloudflare's always-pass test key; set the real key on Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
